# Demo env — copy file này thành `.env` cho dev local.
# .env đã ở .gitignore, KHÔNG commit.
#
# Cách dùng:
#   cp .env.example .env
#   npm run demo
#
# Default: claude-cli (Claude Code subscription, không cần API key).
# Charge vào quota Pro/Max/Team. Yêu cầu: cài `claude` CLI + đã login
# (`claude setup-token`). KHÔNG dùng cho production third-party app
# (vi phạm ToS Anthropic 02/2026).

# Provider cho DSL generation (Dựng hình).
# Lựa chọn: claude-cli (dev/eval) | anthropic (production) | ollama (offline).
WHITEBOARD_AI_PROVIDER=claude-cli

# Model Claude. Default 'claude-sonnet-4-6' (rẻ, đủ cho DSL gen).
# Override qua CLAUDE_CLI_MODEL (claude-cli path) hoặc WHITEBOARD_AI_ANTHROPIC_MODEL (anthropic path).
# CLAUDE_CLI_MODEL=claude-sonnet-4-6
# WHITEBOARD_AI_ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Anthropic API path (production) ───────────────────────────────────
# Bỏ comment + đổi WHITEBOARD_AI_PROVIDER=anthropic.
# Lấy key ở https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Ollama path (offline, free, cần ollama serve) ─────────────────────
# Bỏ comment + đổi WHITEBOARD_AI_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3:4b
