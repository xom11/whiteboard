# Demo env — copy file này thành `.env` rồi điền API key.
# .env đã ở .gitignore, KHÔNG commit.
#
# Cách dùng:
#   cp .env.example .env
#   # edit .env, dán ANTHROPIC_API_KEY
#   npm run demo

# Provider cho DSL generation (Dựng hình).
# Lựa chọn: anthropic | ollama | claude-cli. Default 'ollama' nếu unset.
WHITEBOARD_AI_PROVIDER=anthropic

# API key Anthropic. Lấy ở https://console.anthropic.com/settings/keys
# Bắt buộc khi WHITEBOARD_AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-paste-key-vào-đây

# Model Anthropic cho DSL gen. Default 'claude-sonnet-4-6' (rẻ).
# Các option khác: 'claude-opus-4-7' (vision-best, đắt ~5x), 'claude-haiku-4-5-20251001' (nhanh nhất, kém DSL gen).
# WHITEBOARD_AI_ANTHROPIC_MODEL=claude-sonnet-4-6

# (Tuỳ chọn) Ollama config — chỉ cần khi WHITEBOARD_AI_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3:4b
