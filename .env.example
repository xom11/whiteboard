# Demo env — copy thành `.env` cho dev local. .env trong .gitignore.
#
# Cách dùng:
#   cp .env.example .env
#   # edit nếu cần (default config sẵn sàng dùng nếu đã `claude setup-token`)
#   npm run demo
#
# Default: claude-agent-sdk (Anthropic Agent SDK official) — dùng OAuth
# subscription Pro/Max/Team, KHÔNG cần API key console. Nhanh hơn claude-cli
# subprocess ~5-10x (~10-30s/call vs 1-2 phút).

# Provider cho DSL generation (Dựng hình).
# Lựa chọn:
#   claude-agent-sdk (dev/eval) — Agent SDK, OAuth subscription
#   anthropic        (production) — API key console, pay-per-token
#   claude-cli       (legacy) — spawn `claude -p` subprocess, chậm hơn
#   ollama           (offline) — local Gemma 3, free
WHITEBOARD_AI_PROVIDER=claude-agent-sdk

# ─── Claude Agent SDK path (default, official subscription) ────────────
# Lấy token: cài `claude` CLI rồi chạy `claude setup-token` (browser auth).
# Token lưu ở ~/.claude/.credentials.json (claudeAiOauth.accessToken).
# Auth precedence: ANTHROPIC_API_KEY > CLAUDE_CODE_OAUTH_TOKEN, KHÔNG set API key!
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-paste-token-vào-đây

# Model override (default 'claude-sonnet-4-6')
# CLAUDE_AGENT_SDK_MODEL=claude-sonnet-4-6

# ─── Anthropic API path (production pay-per-token) ─────────────────────
# Bỏ comment + đổi WHITEBOARD_AI_PROVIDER=anthropic.
# Lấy key https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...
# WHITEBOARD_AI_ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Claude CLI subprocess (legacy, chậm) ───────────────────────────────
# Bỏ comment + đổi WHITEBOARD_AI_PROVIDER=claude-cli.
# CLAUDE_CLI_MODEL=claude-sonnet-4-6

# ─── Ollama path (offline, free) ────────────────────────────────────────
# Bỏ comment + đổi WHITEBOARD_AI_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=gemma3:4b
